<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Please excuse my poor coding skills, it's my first time -->

    <!-- Permission to query all installed packages -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>

    <application
        android:name="org.g5.core.Tracker"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Overseer"
        tools:targetApi="31">

        <activity android:name=".Index"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="org.g5.ui.Login" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.Home" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.Permission" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.Summary" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.ScreenTime" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.quiz.Q1Start" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.quiz.Q2Start" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.quiz.Q2Done" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.quiz.Q3Start" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.quiz.Q3Done" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.quiz.LikertQuestion" android:screenOrientation="portrait" android:launchMode="singleTop"/>
        <activity android:name="org.g5.ui.quiz.Report" android:screenOrientation="portrait" android:launchMode="singleTop"/>
    </application>

</manifest>
