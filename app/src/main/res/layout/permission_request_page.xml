<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permission_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:text="APP PERMISSIONS"
        android:fontFamily="@font/citrus"
        android:textSize="37sp"
        android:textColor="@color/opposite" />

    <TextView
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="15dp"
        android:fontFamily="@font/itc_avante_gothic"
        android:justificationMode="inter_word"
        android:text="@string/permission_description"
        android:textColor="@color/opposite"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header" />

    <ImageButton
        android:id="@+id/app_usage_help"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@color/none"
        android:layout_marginTop="70dp"
        android:layout_marginStart="15dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/desc"
        app:srcCompat="@drawable/help_dark" />

    <me.grantland.widget.AutofitTextView
        android:id="@+id/app_usage_permission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="23sp"
        android:text="APP USAGE PERMISSION"
        android:textAlignment="viewStart"
        android:fontFamily="@font/citrus"
        android:textColor="@color/opposite"
        android:layout_marginTop="68dp"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@id/grant_app_usage"
        app:layout_constraintStart_toEndOf="@+id/app_usage_help"
        app:layout_constraintTop_toBottomOf="@+id/desc" />

    <Button
        android:id="@+id/grant_app_usage"
        android:background="@drawable/unactivated_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GRANT"
        android:fontFamily="@font/citrus"
        android:textSize="20sp"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="15dp"
        android:layout_marginStart="15dp"
        android:textColor="@color/opposite"
        android:paddingHorizontal="27dp"
        android:paddingVertical="13dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintTop_toBottomOf="@id/desc"
        app:layout_constraintStart_toEndOf="@id/app_usage_permission"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/notifications_help"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@color/none"
        android:layout_marginTop="82dp"
        android:layout_marginStart="15dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_usage_help"
        app:srcCompat="@drawable/help_dark" />

    <me.grantland.widget.AutofitTextView
        android:id="@+id/notifications_permission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="23sp"
        android:text="NOTIFICATION PERMISSION"
        android:textAlignment="viewStart"
        android:fontFamily="@font/citrus"
        android:textColor="@color/opposite"
        android:layout_marginTop="80dp"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@id/grant_notifications"
        app:layout_constraintStart_toEndOf="@+id/notifications_help"
        app:layout_constraintTop_toBottomOf="@+id/app_usage_help" />

    <Button
        android:id="@+id/grant_notifications"
        android:background="@drawable/unactivated_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GRANT"
        android:fontFamily="@font/citrus"
        android:textSize="20sp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="69dp"
        android:layout_marginEnd="15dp"
        android:textColor="@color/opposite"
        android:paddingHorizontal="27dp"
        android:paddingVertical="13dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintTop_toBottomOf="@id/app_usage_help"
        app:layout_constraintStart_toEndOf="@id/app_usage_permission"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/proceed"
        android:background="@drawable/unactivated_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTINUE"
        android:fontFamily="@font/citrus"
        android:textSize="25sp"
        android:textColor="@color/opposite"
        android:paddingHorizontal="40dp"
        android:paddingVertical="15dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/query_apps_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="15dp"
        android:fontFamily="@font/itc_avante_gothic"
        android:textAlignment="center"
        android:text="@string/query_desc"
        android:textColor="@color/opposite"
        android:textSize="15sp"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintTop_toBottomOf="@id/notifications_permission"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/proceed" />

    <View
        android:id="@+id/filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:elevation="2dp"
        android:background="@color/darken_filter" />

    <View
        android:id="@+id/permission_view"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:elevation="2dp"
        android:background="@drawable/rounded_top"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/app_usage_permission_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="APP USAGE PERMISSION"
        android:textAlignment="center"
        android:fontFamily="@font/citrus"
        android:textSize="25sp"
        android:elevation="2dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toTopOf="@id/app_usage_permission_desc"
        app:layout_constraintTop_toTopOf="@+id/permission_view"
        app:layout_constraintStart_toStartOf="@+id/permission_view"
        app:layout_constraintEnd_toEndOf="@+id/permission_view" />

    <TextView
        android:id="@+id/app_usage_permission_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/why_open_app_usage"
        android:textAlignment="center"
        android:fontFamily="@font/itc_avante_gothic"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:elevation="2dp"
        android:layout_marginHorizontal="15dp"
        android:justificationMode="inter_word"
        app:layout_constraintBottom_toTopOf="@+id/exit_app_usage_perms"
        app:layout_constraintTop_toBottomOf="@+id/app_usage_permission_title"
        app:layout_constraintStart_toStartOf="@+id/permission_view"
        app:layout_constraintEnd_toEndOf="@+id/permission_view" />

    <Button
        android:id="@+id/exit_app_usage_perms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/unactivated_button_2"
        android:textColor="@color/opposite"
        android:text="OK"
        android:fontFamily="@font/citrus"
        android:textSize="20sp"
        android:elevation="2dp"
        android:paddingHorizontal="27dp"
        android:paddingVertical="13dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/permission_view"
        app:layout_constraintTop_toBottomOf="@+id/app_usage_permission_desc"
        app:layout_constraintStart_toStartOf="@+id/permission_view"
        app:layout_constraintEnd_toEndOf="@+id/permission_view" />

    <View
        android:id="@+id/notifications_view"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:elevation="2dp"
        android:background="@drawable/rounded_top"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <me.grantland.widget.AutofitTextView
        android:id="@+id/notifications_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="NOTIFICATIONS PERMISSION"
        android:textAlignment="center"
        android:fontFamily="@font/citrus"
        android:elevation="2dp"
        android:textSize="25sp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toTopOf="@+id/notification_desc"
        app:layout_constraintTop_toTopOf="@+id/notifications_view"
        app:layout_constraintStart_toStartOf="@+id/notifications_view"
        app:layout_constraintEnd_toEndOf="@+id/notifications_view" />

    <TextView
        android:id="@+id/notification_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/why_open_notifs"
        android:textAlignment="center"
        android:elevation="2dp"
        android:fontFamily="@font/itc_avante_gothic"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="15dp"
        android:justificationMode="inter_word"
        app:layout_constraintBottom_toTopOf="@+id/exit_notifications_perms"
        app:layout_constraintTop_toBottomOf="@+id/notifications_title"
        app:layout_constraintStart_toStartOf="@+id/notifications_view"
        app:layout_constraintEnd_toEndOf="@+id/notifications_view" />

    <Button
        android:id="@+id/exit_notifications_perms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/unactivated_button_2"
        android:textColor="@color/opposite"
        android:text="OK"
        android:elevation="2dp"
        android:fontFamily="@font/citrus"
        android:textSize="20sp"
        android:paddingHorizontal="27dp"
        android:paddingVertical="13dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/notifications_view"
        app:layout_constraintTop_toBottomOf="@+id/notification_desc"
        app:layout_constraintStart_toStartOf="@+id/notifications_view"
        app:layout_constraintEnd_toEndOf="@+id/notifications_view" />
</androidx.constraintlayout.widget.ConstraintLayout>