<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="checkup report"
        android:fontFamily="@font/citrus"
        android:textSize="37sp"
        android:textColor="@color/opposite"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ymtd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="your mood today is..."
        android:fontFamily="@font/citrus"
        android:textSize="28sp"
        android:textColor="@color/opposite"
        android:textAlignment="center"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <ImageView
        android:id="@+id/mood"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:src="@drawable/angry"
        android:layout_marginTop="20dp"
        android:maxWidth="40dp"
        android:layout_marginHorizontal="70dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ymtd" />

    <TextView
        android:id="@+id/mood_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="angry"
        android:fontFamily="@font/citrus"
        android:textSize="25sp"
        android:textColor="@color/opposite"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mood" />

    <TextView
        android:id="@+id/energy_level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Energy level: 0"
        android:fontFamily="@font/citrus"
        android:textSize="25sp"
        android:textColor="@color/opposite"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mood_desc" />

    <TextView
        android:id="@+id/stress_level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Stress level: 10"
        android:fontFamily="@font/citrus"
        android:textSize="25sp"
        android:textColor="@color/opposite"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/energy_level" />

    <Button
        android:id="@+id/finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FINISH"
        android:fontFamily="@font/citrus"
        android:textSize="25sp"
        android:textColor="@color/opposite"
        android:paddingHorizontal="40dp"
        android:background="@drawable/activated_button"
        android:layout_marginBottom="60dp"
        android:paddingVertical="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>