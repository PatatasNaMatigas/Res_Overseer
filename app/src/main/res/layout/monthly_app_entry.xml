<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_corner_variant_1"
    android:padding="10dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="20dp">

    <TextView
        android:id="@+id/month"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:fontFamily="@font/citrus"
        android:textColor="?attr/colorPrimary"
        android:textSize="15sp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/app_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/month"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/app_2"
        app:layout_constraintBottom_toTopOf="@id/app_3" />

    <ImageView
        android:id="@+id/app_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="@id/app_1"
        app:layout_constraintStart_toEndOf="@id/app_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/app_1"/>

    <ImageView
        android:id="@+id/app_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/app_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/app_4"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/app_4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/app_1"
        app:layout_constraintStart_toEndOf="@id/app_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>