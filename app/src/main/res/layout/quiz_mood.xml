<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/quiz_bg">

    <!-- Question Text -->
    <TextView
        android:id="@+id/questionText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/panel"
        android:gravity="center"
        android:paddingTop="70dp"
        android:paddingLeft="50dp"
        android:paddingRight="50dp"
        android:paddingBottom="20dp"
        android:text="From the given options, please pick the emotion that you relate to the most as of today."
        android:textColor="@android:color/white"
        android:textSize="29sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeMaxTextSize="39sp"
        android:autoSizeMinTextSize="5sp"
        app:layout_constraintDimensionRatio="1:0.85"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Reaction Grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reactionGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/questionText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp">

        <!-- Reaction 1 -->
        <LinearLayout
            android:id="@+id/reaction1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.25">

            <ImageButton
                android:id="@+id/button_happy"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/happy_icon" />

            <TextView
                android:id="@+id/label_happy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Happy"
                android:textSize="16sp"
                android:textColor="@android:color/darker_gray"
                android:gravity="center" />
        </LinearLayout>

        <!-- Reaction 2 -->
        <LinearLayout
            android:id="@+id/reaction2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/reaction1"
            app:layout_constraintWidth_percent="0.25">

            <ImageButton
                android:id="@+id/button_wow"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/dizzy_icon" />

            <TextView
                android:id="@+id/label_wow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wow"
                android:textSize="16sp"
                android:textColor="@android:color/darker_gray"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reaction3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/reaction2"
            app:layout_constraintWidth_percent="0.25">

            <ImageButton
                android:id="@+id/button_sad"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/tired_icon" />

            <TextView
                android:id="@+id/label_sad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sad"
                android:textSize="16sp"
                android:textColor="@android:color/darker_gray"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reaction4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/reaction3"
            app:layout_constraintWidth_percent="0.25">

            <ImageButton
                android:id="@+id/button_angry"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/dead_icon" />

            <TextView
                android:id="@+id/label_angry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Angry"
                android:textSize="16sp"
                android:textColor="@android:color/darker_gray"
                android:gravity="center" />
        </LinearLayout>

        <!-- Repeat for other reactions with similar constraints -->
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
